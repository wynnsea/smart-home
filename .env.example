# Copy this file to .env and paste your OpenRouter API key.
# .env is gitignored so your key will never be committed.
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here
AI_GATEWAY_URL=https://openrouter.ai/api/v1

# Optional: auto-connect to your PC Windows running wynndiff_bridge over Tailscale
# BRIDGE_HOST=100.85.100.80
# BRIDGE_PORT=8787
# BRIDGE_TOKEN=ganti-dengan-token-rahasia-kamu
